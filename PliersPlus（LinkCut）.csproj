    <MakeDir Directories="$(ModFolder)" Condition="!Exists('$(ModFolder)')" />
    <!-- 复制 DLL -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModFolder)" />
    <!-- 如果有 .pdb 调试文件，也可以复制（可选） -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(ModFolder)" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
