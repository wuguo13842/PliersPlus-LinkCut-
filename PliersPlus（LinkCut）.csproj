  <Target Name="CopyModToGame" AfterTargets="Build">
    <!-- 使用 WriteLinesToFile 生成 mod_info.yaml -->
    <WriteLinesToFile File="$(ModFolder)/mod_info.yaml" Overwrite="true" Encoding="UTF-8" Lines="minimumSupportedBuild: $(MinimumSupportedBuild); APIVersion: $(APIVersion); supportedContent: $(SupportedContent); version: $(ModVersion); staticID: $(ModStaticID)" />
